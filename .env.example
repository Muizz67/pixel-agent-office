# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8787
NODE_ENV=development
LOG_LEVEL=info

# Data and sandbox roots are created automatically.
DATA_DIR=./data
WORKSPACE_ROOT=./workspaces

# ── LLM provider ──────────────────────────────────────────────────────────────
# auto: use OpenAI-compatible provider when OPENAI_API_KEY is present, otherwise mock.
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Optional role-specific overrides. These default to OPENAI_MODEL.
PLANNER_MODEL=
WORKER_MODEL=
LLM_TIMEOUT_MS=90000

# ── Orchestration limits ──────────────────────────────────────────────────────
MAX_CONCURRENT_TASKS=2
MAX_TASKS_PER_RUN=8
MAX_AGENT_STEPS=8
MAX_TASK_ATTEMPTS=2
MAX_RUN_TOKENS=60000
MAX_TOOL_CALLS_PER_RUN=80
RUN_TIMEOUT_MS=900000
APPROVAL_TIMEOUT_MS=600000
# Mock provider delay makes the pixel office pleasant to watch. Set 0 for tests.
MOCK_LATENCY_MS=350

# ── Tools & security ─────────────────────────────────────────────────────────
ENABLE_SHELL_TOOLS=false
ENABLE_FETCH_TOOL=false
REQUIRE_APPROVAL_FOR_COMMANDS=true
# Optional shared secret. When set, API calls need X-Office-Token
# (or ?token= for the SSE stream). The browser UI accepts ?token= once.
OFFICE_API_TOKEN=
# Comma-separated extra origins. localhost origins are always allowed.
ALLOWED_ORIGINS=
